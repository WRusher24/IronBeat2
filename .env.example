# ---------------------------------------------------------------------------
# IronBeat — environment variables
# Copy this file to `.env.local` for local development.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (pooled connection recommended).
# Neon dashboard -> Project -> Connect -> "Connection string" -> Node.js
# Example:
# postgresql://neondb_owner:password@ep-cool-name-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Public base URL of the deployment. Used for absolute Media Session artwork
# URLs and PWA metadata. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# YouTube Data API v3 key — the priority search source.
# Results play through the official IFrame Player (full-length, ToS-compliant).
# Without it, search falls back to Audius + Internet Archive.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""

# Optional: label sent to the Audius API for usage analytics.
# No key or registration is required — this is cosmetic.
AUDIUS_APP_NAME="IronBeat"

# Optional: restrict signups. Leave empty to allow open registration.
# Set to "true" to lock the registration endpoint (existing users can log in).
SIGNUPS_DISABLED="false"
